# ==========================================================================
#  РублЪ AI Director — образец конфигурации
#
#  Заполнять этот файл руками больше не нужно. При установке он создаётся
#  сам, с одним лишь паролем базы; ключи YCLIENTS и Telegram задаются в самом
#  Директоре — «Настройки → Интеграции»: там же можно загрузить готовый .env
#  кнопкой, не открывая редактор.
#
#  Образец остаётся для двух случаев: развёртывание на сервере, где значения
#  задаются инфраструктурой, и перенос настроек со старой установки.
#
#  ВНИМАНИЕ: здесь только заглушки. Настоящие ключи живут ТОЛЬКО в .env,
#  который добавлен в .gitignore и никогда не попадает в архив или репозиторий.
#  В прошлой версии в этом файле лежали боевые ключи — не повторять.
# ==========================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Единственное, что обязано быть здесь: приложение хранит управляемые
# настройки в самой базе, и настроить доступ к базе через них невозможно.
# При установке пароль генерируется автоматически.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rubl_director
POSTGRES_USER=rubl
# Только шестнадцатеричный вид: пароль подставляется в адрес подключения
# к базе, а знаки / + @ : в адресе значат другое и рвут его на части.
POSTGRES_PASSWORD=<сгенерировать: openssl rand -hex 24>

# ── FastAPI ───────────────────────────────────────────────────────────────
APP_PORT=8000
DEBUG=false

# Домены, которым разрешено обращаться к API из браузера.
# Пусто = только тот же домен. Звёздочку не ставить.
CORS_ORIGINS=https://director.rublbarber.ru

# ══════════════════════════════════════════════════════════════════════════
#  Всё, что ниже, задаётся в интерфейсе и здесь нужно только на сервере.
#  Значение, заданное настоящей переменной окружения, интерфейс не меняет:
#  оно показывается с пометкой «задано на сервере» и доступно только чтению.
# ══════════════════════════════════════════════════════════════════════════

# ── Доступ ────────────────────────────────────────────────────────────────
# При первом открытии Директор сам попросит завести владельца: спросит код
# из окна установки, потом логин и пароль. Пароль при этом хранится хешем,
# а не открытым текстом, как здесь.
#
# Строки ниже остаются рабочими для уже развёрнутых установок и для сервера,
# где учётные записи задаются инфраструктурой. Оба пароля — минимум 12
# символов, заведомо слабые отвергаются.
# OWNER_LOGIN=<логин владельца>
# OWNER_PASSWORD=<сгенерировать: openssl rand -base64 18>
# Администратор салона: смена и база обзвона, остальное отдаёт 403.
# OPERATOR_LOGIN=<логин администратора>
# OPERATOR_PASSWORD=<длинная фраза, минимум 12 символов>
# Мастера: каждый видит только свой расчёт зарплаты. staff_id — идентификатор
# сотрудника в YCLIENTS, по нему сервер отбирает строку. Без него учётная
# запись не стартует: непонятно, чьи деньги показывать.
# MASTER_ACCOUNTS=[{"login":"ksenia","password":"<пароль>","staff_id":5659614}]

# ── YCLIENTS ──────────────────────────────────────────────────────────────
# YCLIENTS_PARTNER_TOKEN=<партнёрский токен>
# YCLIENTS_COMPANY_ID=<id филиала>
# YCLIENTS_USER_TOKEN=<пользовательский токен>
# Старый аккаунт — только для сверки при миграции
# YCLIENTS_OLD_COMPANY_ID=0
# YCLIENTS_OLD_USER_TOKEN=

# ── Telegram ──────────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Синхронизация ─────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=60
# Глубина окна выгрузки. Раньше тянулась вся история на каждый запрос.
SYNC_WINDOW_DAYS=90
# Предел на один прогон: зависший ответ YCLIENTS не должен останавливать
# обновление насовсем.
SYNC_TIMEOUT_MINUTES=30
# Сколько секунд держать ответы YCLIENTS в памяти
CACHE_TTL_SECONDS=300

# ── График работы (для расчёта окон) ──────────────────────────────────────
WORK_OPEN_HOUR=10
WORK_CLOSE_HOUR=22
SLOT_STEP_MINUTES=30
