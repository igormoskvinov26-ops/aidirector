# ==========================================================================
#  РублЪ AI Director — шаблон конфигурации
#
#  ЗДЕСЬ ТОЛЬКО ЗАГЛУШКИ. Настоящие значения живут исключительно в .env,
#  который перечислен в .gitignore и никогда не попадает в репозиторий.
#
#  История этого файла была перезаписана 11.09.2026: до этого в нём лежали
#  боевые токены YCLIENTS и пароли, а репозиторий был публичным. Все эти
#  значения считаются скомпрометированными — см. ROTATION.md.
# ==========================================================================

# ── YCLIENTS (обязательно) ────────────────────────────────────────────────
YCLIENTS_PARTNER_TOKEN=<партнёрский токен>
YCLIENTS_COMPANY_ID=<id филиала>
YCLIENTS_USER_TOKEN=<пользовательский токен>

# Старый аккаунт — только для сверки при миграции, можно оставить пустым
YCLIENTS_OLD_COMPANY_ID=0
YCLIENTS_OLD_USER_TOKEN=

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rubl_director
POSTGRES_USER=rubl
# Обязательно. Значения по умолчанию в коде больше нет — сгенерировать:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# ── FastAPI ───────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# ── Админ-доступ ──────────────────────────────────────────────────────────
ADMIN_LOGIN=admin
# Обязательно. Значения по умолчанию в коде больше нет — сгенерировать:
#   openssl rand -base64 18
ADMIN_PASSWORD=

# ── Синхронизация ─────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=60

# ── Telegram (необязательно) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
