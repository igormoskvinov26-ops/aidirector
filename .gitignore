# Секреты — никогда в репозиторий
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key

__pycache__/
*.pyc
.venv/
venv/
node_modules/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
postgres_data/
output/
.DS_Store

# Архивы и крупные бинарники держим вне репозитория:
# в них легко унести секрет незаметно для code review
*.zip
*.tar
*.tar.gz
*.7z

# Собранный установщик для Windows — по той же причине. Внутрь него
# упакован весь исходный код, и проверить на code review, что туда не уехал
# .env, по двоичному файлу невозможно. Собирается из installer/build.sh за
# полминуты, хранить его тут незачем.
*.exe
installer/payload/
