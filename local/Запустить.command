#!/usr/bin/env bash
# Двойной щелчок по этому файлу запускает Директора на Mac.
#
# Ожидание Enter в конце нужно именно для двойного щелчка: Finder закрывает
# окно сразу по выходу скрипта, и прочитать адрес или ошибку не успеваешь.
#
# Из Терминала запускать не этот файл, а ./start.sh — там ожидания нет.
# Иначе оно съедает следующую вставленную строку вместо Enter, и команда
# молча не выполняется.
cd "$(dirname "$0")"
./start.sh
echo ""
read -r -p "Нажмите Enter, окно можно закрыть..." _
