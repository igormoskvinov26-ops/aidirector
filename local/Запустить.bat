@echo off
chcp 65001 >nul
rem ========================================================================
rem  Двойной щелчок по этому файлу запускает Директора на Windows.
rem
rem  Вся работа в start.ps1. Здесь только вызов, потому что в bat нет ни
rem  нормальных условий, ни ожидания в цикле — а проверок перед запуском
rem  нужно много.
rem
rem  Прошлая версия вызывала bash, которого в Windows нет, и не работала
rem  вообще.
rem ========================================================================
cd /d "%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0start.ps1"
echo.
pause
