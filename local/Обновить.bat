@echo off
chcp 65001 >nul
rem ========================================================================
rem  Двойной щелчок по этому файлу обновляет Директора до последней версии
rem  кода из git и перезапускает его через start.ps1.
rem
rem  Вся работа в update.ps1 — как и в Запустить.bat, здесь только вызов.
rem ========================================================================
cd /d "%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0update.ps1"
echo.
pause
